{
  "hooks": {

    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/block_files_hook.js"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(git * main)",
      "Bash(git * master)"
    ],
    "deny": [
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.env)",
      "Bash(git push *)"
    ]
  }
}
